# Public site URL used for canonicals, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.loopcstrategies.com

# LoopC ERP SaaS app (pricing / signup / workspace) — browser-visible
NEXT_PUBLIC_ERP_URL=http://localhost:3001

# Server-side ERP public API (CMS, plans, contact). Defaults to NEXT_PUBLIC_ERP_URL.
ERP_API_URL=http://localhost:3001

# Optional Formspree fallback if ERP contact API is unreachable
FORMSPREE_FORM_ID=
CONTACT_TO_EMAIL=

# Optional Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
