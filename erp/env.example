# Database
DATABASE_URL="postgresql://erp:erp@localhost:5433/loopc_erp?schema=public"

# Auth.js
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
APP_URL=http://localhost:3001
MARKETING_URL=http://localhost:3000

# Razorpay (leave empty to use mock provider in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (optional — structure ready, not required for local mock)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@loopcstrategies.com

# Storage abstraction (local | s3 | gcs)
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# Seed (development only — never commit real secrets)
SEED_ADMIN_EMAIL=admin@loopcstrategies.com
SEED_ADMIN_PASSWORD=
