# Database
DATABASE_URL="postgresql://erp:erp@localhost:5433/loopc_erp?schema=public"

# Auth.js
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# Portal (this sales / account / admin Next app — NOT the ERP product)
NEXT_PUBLIC_APP_URL=http://localhost:3001
APP_URL=http://localhost:3001
# Super Admin intended host (same deploy; middleware restricts admin.* to /admin)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
ADMIN_URL=http://localhost:3001

# Marketing site origin(s) for public API CORS
MARKETING_URL=http://localhost:3000
# Comma-separated extra origins (production www, apex, previews)
PUBLIC_CORS_ORIGINS=

# External LoopC ERP product (customers open this after subscribe)
# Prefer ERP_APP_URL; EXTERNAL_* aliases still work
ERP_APP_URL=https://erp.example-domain.com
NEXT_PUBLIC_ERP_APP_URL=https://erp.example-domain.com
EXTERNAL_ERP_URL=https://erp.example-domain.com
NEXT_PUBLIC_EXTERNAL_ERP_URL=https://erp.example-domain.com

# Razorpay (leave empty to use mock provider in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (optional — structure ready, not required for local mock)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@loopcstrategies.com

# Storage abstraction (local | s3 | gcs)
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# Seed (development only — never commit real secrets)
SEED_ADMIN_EMAIL=admin@loopcstrategies.com
SEED_ADMIN_PASSWORD=
